---
/**
 * LnBeatsPlaylist.astro
 * Reusable embed component for LNbeats playlists
 */

interface Props {
  /** Full playlist URL from lnbeats.com */
  playlistUrl: string

  /** Optional title shown above the player */
  title?: string

  /** Height of the player iframe */
  height?: string
}

const {
  playlistUrl,
  title = "Listen on LNbeats",
  height = "420px",
} = Astro.props;
---

<section class="lnbeats-embed">
  {title && <h3>{title}</h3>}

  <div class="player-wrapper">
    <iframe
      src={playlistUrl}
      loading="lazy"
      allow="autoplay; encrypted-media"
      allowfullscreen
      title="LNbeats Playlist Player"
    />
  </div>
</section>

<style>
  .lnbeats-embed {
    margin: 2rem 0;
  }

  .lnbeats-embed h3 {
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
  }

  .player-wrapper {
    position: relative;
    width: 100%;
    height: var(--player-height);
  }

  .player-wrapper iframe {
    width: 100%;
    height: 100%;
    border: none;
    border-radius: 8px;
  }
</style>

<style define:vars>
  :root {
    --player-height: {height};
  }
</style>
