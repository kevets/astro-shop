---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<div class="group relative border border-zinc-800 bg-black p-4 hover:border-orange-500 transition-all duration-300">
  <div class="flex justify-between text-[10px] font-mono text-zinc-500 mb-4">
    <span>TYPE: {type.toUpperCase()}</span>
    <span>LOC: {type === 'apparel' ? 'GLOBAL_DISPATCH' : 'STEVE_HQ'}</span>
  </div>

  <div class="aspect-square overflow-hidden bg-zinc-900 mb-4">
    <img src={image} alt={name} class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
  </div>

  <h3 class="text-xl font-bold text-white uppercase tracking-tighter mb-1">{name}</h3>
  <p class="text-orange-500 font-mono text-lg mb-4">{price}</p>

  <a href={link} class="block w-full bg-zinc-800 text-white text-center py-3 font-bold uppercase tracking-widest hover:bg-orange-600 transition-colors">
    {type === 'apparel' ? 'View Gear' : 'Secure Batch'}
  </a>

  <div class="absolute -bottom-1 -right-1 w-4 h-4 border-r-2 border-b-2 border-orange-600 opacity-0 group-hover:opacity-100 transition-opacity"></div>
</div>
