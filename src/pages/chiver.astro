---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Small Batch Steve TV</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/nostr-tools/lib/nostr.bundle.js"></script>
    <style>
        body { background-color: #0a0a0a; color: #e5e5e5; overflow: hidden; }
        /* Focus state for D-Pad navigation */
        .video-card:focus { 
            transform: scale(1.1); 
            border: 4px solid #FF6B00; 
            outline: none; 
            z-index: 10;
        }
        .scroll-container { display: flex; transition: transform 0.3s ease; }
    </style>
</head>
<body class="p-12 font-mono">

    <header class="mb-8 flex justify-between items-center border-b border-zinc-800 pb-4">
        <h1 class="text-3xl font-black text-orange-600 uppercase tracking-tighter">Small Batch Steve // Video Signal</h1>
        <div id="status" class="text-xs text-zinc-500 italic uppercase">Connecting to Relay...</div>
    </header>

    <div class="relative overflow-visible">
        <div id="video-rail" class="scroll-container gap-6">
            </div>
    </div>

    <div id="player-overlay" class="fixed inset-0 bg-black hidden flex items-center justify-center z-50">
        <video id="tv-player" controls class="w-full h-full"></video>
        <div class="absolute top-8 left-8 text-orange-600 font-bold uppercase tracking-widest">Back to Feed [ESC / Return]</div>
    </div>
<div id="tip-overlay" class="fixed inset-0 bg-black/95 hidden z-[60] flex flex-col items-center justify-center p-8">
    <div class="border-2 border-orange-600 p-8 text-center max-w-lg">
        <h2 class="text-3xl font-black text-orange-600 mb-2 uppercase tracking-tighter">Support the Batch</h2>
        <p class="text-zinc-400 font-mono text-sm mb-6 uppercase">Scan to send sats via Lightning Network</p>
        
        <div id="tip-qr" class="bg-white p-4 inline-block mb-6">
            </div>

        <div class="text-orange-500 font-mono text-lg mb-8">npub...q6qnsxk</div>
        
        <button onclick="toggleTip()" class="text-zinc-500 border border-zinc-700 px-6 py-2 hover:text-white uppercase text-xs">
            Close [Back / Return]
        </button>
    </div>
</div>
<script>
    const STEVE_PUBKEY = "82341f882b6dbaa0d6d56d56d56d56d56d56d56d56d56d56d56d56d56d56d56d";
    const RELAY = "wss://relay.primal.net";
    const rail = document.getElementById('video-rail');

    async function init() {
        const relay = window.NostrTools.relayInit(RELAY);
        await relay.connect();
        document.getElementById('status').innerText = "Signal: Online";

        // Query for Kind 20 (Video Events) or Kind 1 (Short Notes with Video)
        const sub = relay.sub([{
            authors: [STEVE_PUBKEY],
            kinds: [20, 1], // Pulling Video events and Standard notes
            limit: 20
        }]);

        sub.on('event', event => {
            // Find Video URLs in tags or content
            const videoUrl = event.tags.find(t => t[0] === 'url')?.[1] || 
                             event.content.match(/\bhttps?:\/\/\S+\.(mp4|m3u8|mov)\b/i)?.[0];
            
            if (videoUrl) renderCard(event, videoUrl);
        });
    }

    function renderCard(event, url) {
        const card = document.createElement('div');
        card.className = "video-card min-w-[400px] h-[225px] bg-zinc-900 relative transition-all duration-200 cursor-pointer";
        card.tabIndex = 0; // Essential for TV Focus
        
        card.innerHTML = `
            <div class="absolute inset-0 bg-gradient-to-t from-black to-transparent opacity-60"></div>
            <div class="absolute bottom-4 left-4 right-4">
                <p class="text-xs text-orange-500 mb-1">BATCH SIGNAL</p>
                <h3 class="text-sm font-bold truncate uppercase">${event.content.substring(0, 40)}...</h3>
            </div>
        `;

        card.onkeydown = (e) => { if (e.key === 'Enter') playVideo(url); };
        card.onclick = () => playVideo(url);
        rail.appendChild(card);
    }

    function playVideo(url) {
        const overlay = document.getElementById('player-overlay');
        const video = document.getElementById('tv-player');
        video.src = url;
        overlay.classList.remove('hidden');
        video.play();
    }

    // Remote Control Logic
    window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' || e.key === 'Backspace') {
            document.getElementById('player-overlay').classList.add('hidden');
            document.getElementById('tv-player').pause();
        }
    });

// Load the QR library in your head:
// <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.1/build/qrcode.min.js"></script>

const LIGHTNING_ADDRESS = "smallbatchsteve@rizful.com"; // Replace with your actual LN Address

function toggleTip() {
    const overlay = document.getElementById('tip-overlay');
    const isHidden = overlay.classList.contains('hidden');
    
    if (isHidden) {
        generateTipQR();
        overlay.classList.remove('hidden');
    } else {
        overlay.classList.add('hidden');
    }
}

function generateTipQR() {
    const target = document.getElementById('tip-qr');
    target.innerHTML = ''; // Clear previous

    // We use the lightning: prefix to trigger wallet apps
    QRCode.toString(`lightning:${LIGHTNING_ADDRESS}`, {
        type: 'svg',
        color: { dark: '#000000', light: '#FFFFFF' },
        width: 300,
        margin: 1
    }, function (err, svg) {
        if (err) return console.error(err);
        target.innerHTML = svg;
    });
}

// Remote Key Support: Map the 'Yellow' button (if available) or 'C' key
window.addEventListener('keydown', (e) => {
    // 67 is 'c' key, often mapped to specialized TV buttons
    if (e.keyCode === 67) { 
        toggleTip();
    }
    // Standard back button closes the tip
    if (e.key === 'Escape' || e.key === 'Backspace' || e.keyCode === 10009) {
        document.getElementById('tip-overlay').classList.add('hidden');
    }
});

    init();
</script>
</body>
</html>
