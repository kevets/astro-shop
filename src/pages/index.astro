---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.1/build/qrcode.min.js"></script>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
<h1>🔥Small Batch Steve's Seasonings🔥</h1>
Shipping is US only currently (December, 2025)<br>
Bitcoin users: Buy Survival Seasoning at https://www.takemysats.com/small-batch-steve<br>
LNQR users:
<button onclick="openLightningModal('') " class="bg-orange-600 hover:bg-orange-700 text-black font-black px-6 py-3 uppercase font-mono shadow-[4px_4px_0px_0px_rgba(255,107,0,0.3)]">
  Pay with Lightning
</button>

<div id="qr-modal" class="fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="bg-zinc-900 border-2 border-orange-600 w-full max-w-md p-6 font-mono relative">
    
    <button onclick="closeModal()" class="absolute top-2 right-2 text-zinc-500 hover:text-white text-xl">
      [X]
    </button>

    <div class="text-center">
      <h3 class="text-orange-500 font-bold uppercase tracking-widest mb-2">Inbound Signal: Lightning</h3>
      <div class="bg-white p-4 inline-block rounded-sm mb-4" id="canvas-container">
        <div id="qrcode-target"></div>
      </div>

      <div class="bg-black border border-zinc-800 p-3 mb-6">
        <p class="text-[10px] text-zinc-500 uppercase mb-1 text-left">Invoice ID</p>
        <p id="invoice-text" class="text-[10px] text-white break-all text-left font-mono"></p>
      </div>

      <button onclick="copyInvoice()" class="w-full border border-orange-600 text-orange-600 hover:bg-orange-600 hover:text-black py-2 text-xs uppercase transition-all">
        Copy Invoice String
      </button>
    </div>
  </div>
</div>

